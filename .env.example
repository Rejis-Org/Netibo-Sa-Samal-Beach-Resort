# Create a Supabase project in the client's account, then add these values locally.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key. Never expose this in browser code or commit a real value.
SUPABASE_SECRET_KEY=

# Public website address with no trailing slash (for example https://your-domain.com).
# Used for private booking links in emails. Optional.
NEXT_PUBLIC_SITE_URL=

# Optional guest emails through Resend (https://resend.com). Leave both blank to send no emails.
# BOOKING_EMAIL_FROM must be an address on a domain verified in Resend.
RESEND_API_KEY=
BOOKING_EMAIL_FROM=
